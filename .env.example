# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real keys.

# Resend — used by /api/contact to send contact form emails
# 1. Sign up at https://resend.com (free: 3,000 emails/month)
# 2. Go to Domains → Add Domain → verify saltandlighttechnologies.com
# 3. Go to API Keys → Create API Key
# 4. Paste the key below (local dev) AND add it in Vercel → Project Settings → Environment Variables (production)
RESEND_API_KEY=re_YOUR_API_KEY_HERE
